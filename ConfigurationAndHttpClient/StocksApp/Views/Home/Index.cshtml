@model StocksApp.Models.Stock
@{
    ViewBag.Title = "Home";
}

<div class="box trading-panel">
    <div class="flex trading-panel-flex">

        <div id="stock-price-panel">
            <div class="stock">
                <h1 class="stock-title">@Model.StockSymbol</h1>

                <table>
                    <tbody>
                        <tr>
                            <td>Current Price</td>
                            <th>
                                <small>$</small>
                                <span class="price">
                                    @Model.CurrentPrice.ToString("N")
                                </span>
                            </th>
                        </tr>
                        <tr>
                            <td>High Price</td>
                            <th>
                                <small>$</small>
                                <span class="price">
                                    @Model.HighPriceOfTheDay.ToString("N")
                                </span>
                            </th>
                        </tr>
                        <tr>
                            <td>Lowest Price</td>
                            <th>
                                <small>$</small>
                                <span class="price">
                                    @Model.LowPriceOfTheDay.ToString("N")
                                </span>
                            </th>
                        </tr>
                        <tr>
                            <td>Open Price</td>
                            <th>
                                <small>$</small>
                                <span class="price">
                                    @Model.OpenPriceOfTheDay.ToString("N")
                                </span>
                            </th>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>